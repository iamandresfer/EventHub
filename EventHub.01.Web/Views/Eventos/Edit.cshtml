@model EventHub._02.Bussines.DTOs.EventoFormDto
@{
    ViewBag.Title = "Editar Evento";
    ViewBag.HeaderTitle = "Editar Evento";
    ViewBag.HeaderSubtitle = "Modifique los datos del evento";
    ViewBag.BackUrl = Url.Action("Index");
}

@using (Html.BeginForm("Edit", "Eventos", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="card">
        <div class="form-group">
            @Html.LabelFor(m => m.Nombre)
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Nombre del evento", maxlength = "150" })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "field-error" })
        </div>

        <div class="form-row">
            <div class="form-group">
                <div style="display:flex;align-items:center;gap:8px;">
                    @Html.LabelFor(m => m.ClienteId)
                    <a href="#" id="openClientModal" style="color:var(--primary);font-size:13px;font-weight:500;">+ Nuevo Cliente</a>
                </div>
                @Html.DropDownListFor(m => m.ClienteId, (SelectList)ViewBag.Clientes, "-- Seleccione --", new { @class = "form-control", id = "ClienteId" })
                @Html.ValidationMessageFor(m => m.ClienteId, "", new { @class = "field-error" })
            </div>
            <div class="form-group">
                <div style="display:flex;align-items:center;gap:8px;">
                    @Html.LabelFor(m => m.TipoEventoId)
                    <a href="#" id="openTipoEventoModal" style="color:var(--primary);font-size:13px;font-weight:500;">+ Nuevo Tipo</a>
                </div>
                @Html.DropDownListFor(m => m.TipoEventoId, (SelectList)ViewBag.TiposEvento, "-- Seleccione --", new { @class = "form-control", id = "TipoEventoId" })
                @Html.ValidationMessageFor(m => m.TipoEventoId, "", new { @class = "field-error" })
            </div>
        </div>

        <div class="form-group">
            <div style="display:flex;align-items:center;gap:8px;">
                @Html.LabelFor(m => m.VenueId)
                <a href="#" id="openVenueModal" style="color:var(--primary);font-size:13px;font-weight:500;">+ Nuevo Lugar</a>
            </div>
            @Html.DropDownListFor(m => m.VenueId, (SelectList)ViewBag.Venues, "-- Seleccione --", new { @class = "form-control", id = "VenueId" })
            @Html.ValidationMessageFor(m => m.VenueId, "", new { @class = "field-error" })
        </div>

        <div class="form-row">
            <div class="form-group" style="flex: 2;">
                @Html.LabelFor(m => m.FechaInicio)
                @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "field-error" })
            </div>
            <div class="form-group" style="flex: 1;">
                @Html.LabelFor(m => m.HoraInicio)
                @Html.TextBoxFor(m => m.HoraInicio, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                @Html.ValidationMessageFor(m => m.HoraInicio, "", new { @class = "field-error" })
            </div>
            <div class="form-group" style="flex: 1;">
                @Html.LabelFor(m => m.HoraFin)
                @Html.TextBoxFor(m => m.HoraFin, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                @Html.ValidationMessageFor(m => m.HoraFin, "", new { @class = "field-error" })
            </div>
        </div>

        <div class="form-group" style="margin-top:16px;">
            <label>Foto de Portada (16:9)</label>
            <div class="cover-upload-container">
                <div class="cover-upload" id="coverUpload">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-muted);">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <p style="margin:8px 0 4px;font-size:14px;color:var(--text);">Arrastra o haz clic para subir</p>
                    <p style="margin:0;font-size:12px;color:var(--text-muted);">Recomendado: 1920×1080px (16:9) • JPG/PNG/WebP • &lt;5MB</p>
                </div>
                <input type="file" id="coverFileInput" accept="image/*" style="display:none;" />
                <input type="hidden" name="CoverPhotoUrl" id="CoverPhotoUrl" value="@Model.CoverPhotoUrl" />
            </div>
            <div id="coverPreview" style="display:@(string.IsNullOrEmpty(Model.CoverPhotoUrl) ? "none" : "block");margin-top:12px;position:relative;">
                <div class="cover-cinematic-frame">
                    <img id="coverPreviewImg" src="@Model.CoverPhotoUrl" />
                </div>
                <button type="button" id="removeCoverBtn" class="btn btn-danger btn-sm" style="position:absolute;top:8px;right:8px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.CoverPhotoUrl))
            {
                <script>document.getElementById('coverUpload').style.display = 'none';</script>
            }
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.PresupuestoEstimado)
            @Html.TextBoxFor(m => m.PresupuestoEstimado, "{0:F2}", new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "Opcional" })
            @Html.ValidationMessageFor(m => m.PresupuestoEstimado, "", new { @class = "field-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", placeholder = "Descripción del evento...", maxlength = "1000" })
        </div>
    </div>

    <div style="display:flex;gap:8px;margin-top:16px;">
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a href="@Url.Action("Index")" class="btn btn-outline">Cancelar</a>
    </div>
}

<!-- Client Modal -->
<div id="clientModal" class="modal-overlay" style="display:none;">
    <div class="modal-panel">
        <div class="modal-header">
            <button type="button" id="closeClientModal" class="modal-close-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <h3>Nuevo Cliente</h3>
        </div>
        <div class="modal-body">
            <form id="clientForm">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Nombre *</label>
                    <input type="text" name="Nombre" class="form-control" required maxlength="150" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>RUC / Cédula *</label>
                        <input type="text" name="Ruc" class="form-control" maxlength="13" required pattern="\d{10,13}" />
                    </div>
                    <div class="form-group">
                        <label>Clasificación</label>
                        <select name="Clasificacion" class="form-control">
                            <option value="Nuevo">Nuevo</option>
                            <option value="Regular">Regular</option>
                            <option value="VIP">VIP</option>
                            <option value="Estrategico">Estratégico</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" name="Email" class="form-control" required maxlength="100" />
                    </div>
                    <div class="form-group">
                        <label>Teléfono</label>
                        <input type="text" name="Telefono" class="form-control" maxlength="20" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Contacto</label>
                    <input type="text" name="Contacto" class="form-control" maxlength="150" placeholder="Nombre del representante" />
                </div>
                <div class="form-group">
                    <label>Dirección</label>
                    <input type="text" name="Direccion" class="form-control" maxlength="200" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelClientModal" class="btn btn-outline">Cancelar</button>
            <button type="button" id="saveClientBtn" class="btn btn-primary">Crear y Seleccionar</button>
        </div>
    </div>
</div>

<!-- Venue Modal -->
<div id="venueModal" class="modal-overlay" style="display:none;">
    <div class="modal-panel">
        <div class="modal-header">
            <button type="button" id="closeVenueModal" class="modal-close-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <h3>Nuevo Lugar</h3>
        </div>
        <div class="modal-body">
            <form id="venueForm">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Nombre *</label>
                    <input type="text" name="Nombre" class="form-control" required maxlength="100" placeholder="Ej: Centro de Convenciones" />
                </div>
                <div class="form-group">
                    <label>Dirección *</label>
                    <input type="text" name="Direccion" class="form-control" required maxlength="200" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Ciudad *</label>
                        <input type="text" name="Ciudad" class="form-control" required maxlength="50" />
                    </div>
                    <div class="form-group">
                        <label>Capacidad Máxima</label>
                        <input type="number" name="CapacidadMaxima" class="form-control" min="1" />
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelVenueModal" class="btn btn-outline">Cancelar</button>
            <button type="button" id="saveVenueBtn" class="btn btn-primary">Crear y Seleccionar</button>
        </div>
    </div>
</div>

<!-- Tipo Evento Modal -->
<div id="tipoEventoModal" class="modal-overlay" style="display:none;">
    <div class="modal-panel">
        <div class="modal-header">
            <button type="button" id="closeTipoEventoModal" class="modal-close-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <h3>Nuevo Tipo de Evento</h3>
        </div>
        <div class="modal-body">
            <form id="tipoEventoForm">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Nombre *</label>
                    <input type="text" name="Nombre" class="form-control" required maxlength="50" placeholder="Ej: Conferencia, Festival, Gala..." />
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    <input type="text" name="Descripcion" class="form-control" maxlength="200" placeholder="Breve descripción del tipo de evento" />
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelTipoEventoModal" class="btn btn-outline">Cancelar</button>
            <button type="button" id="saveTipoEventoBtn" class="btn btn-primary">Crear y Seleccionar</button>
        </div>
    </div>
</div>

<style>
    .cover-upload {
        border: 2px dashed var(--border);
        border-radius: 12px;
        padding: 32px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .cover-upload:hover {
        border-color: var(--primary);
        background: var(--primary-light);
    }
    .cover-cinematic-frame {
        width: 100%;
        aspect-ratio: 16 / 7;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        background: #000;
        box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    }
    .cover-cinematic-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 36%;
        display: block;
    }
    .cover-cinematic-frame::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
        pointer-events: none;
    }
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0;
    }
    .modal-panel {
        width: 480px;
        max-width: 100vw;
        height: 100vh;
        background: var(--bg-card);
        display: flex;
        flex-direction: column;
        animation: slideIn 0.25s ease;
    }
    @@keyframes slideIn {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }
    .modal-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
    }
    .modal-header h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }
    .modal-close-btn {
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
    }
    .modal-close-btn:hover {
        color: var(--text);
        background: var(--bg);
    }
    .modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
    }
    .modal-footer {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        padding: 16px 24px;
        border-top: 1px solid var(--border);
    }
</style>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // ===== Cover upload =====
        var coverUpload = document.getElementById('coverUpload');
        var coverFileInput = document.getElementById('coverFileInput');
        var coverPreview = document.getElementById('coverPreview');
        var coverPreviewImg = document.getElementById('coverPreviewImg');
        var removeCoverBtn = document.getElementById('removeCoverBtn');

        coverUpload.addEventListener('click', function() { coverFileInput.click(); });
        coverUpload.addEventListener('dragover', function(e) { e.preventDefault(); coverUpload.style.borderColor = 'var(--primary)'; });
        coverUpload.addEventListener('dragleave', function() { coverUpload.style.borderColor = ''; });
        coverUpload.addEventListener('drop', function(e) {
            e.preventDefault();
            coverUpload.style.borderColor = '';
            if (e.dataTransfer.files.length > 0) handleCoverFile(e.dataTransfer.files[0]);
        });
        coverFileInput.addEventListener('change', function() { if (this.files.length > 0) handleCoverFile(this.files[0]); });

        function handleCoverFile(file) {
            if (!file.type.startsWith('image/')) return;
            if (file.size > 5 * 1024 * 1024) { window.EventHubSwal.error('El archivo debe ser menor a 5MB'); return; }
            var reader = new FileReader();
            reader.onload = function(e) {
                coverPreviewImg.src = e.target.result;
                coverPreview.style.display = 'block';
                coverUpload.style.display = 'none';
            };
            reader.readAsDataURL(file);

            var fd = new FormData();
            fd.append('file', file);
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) fd.append('__RequestVerificationToken', token.value);
            fetch('@Url.Action("UploadCover", "Eventos")', { method: 'POST', body: fd })
            .then(function(r) {
                if (!r.ok) {
                    return r.text().then(function(txt) {
                        throw new Error('Error ' + r.status + ': ' + (txt.substring(0, 200)));
                    });
                }
                return r.json();
            })
            .then(function(data) {
                if (data.success) { document.getElementById('CoverPhotoUrl').value = data.url; }
                else { window.EventHubSwal.error(data.message || 'Error al subir la imagen'); }
            })
            .catch(function(err) { window.EventHubSwal.error('Error al subir imagen: ' + (err.message || 'Error de conexión')); });
        }

        removeCoverBtn.addEventListener('click', function() {
            coverPreview.style.display = 'none';
            coverUpload.style.display = 'block';
            coverFileInput.value = '';
            document.getElementById('CoverPhotoUrl').value = '';
        });

        // ===== Helper: open/close modal + POST form =====
        function openModal(modalId) { document.getElementById(modalId).style.display = 'flex'; }
        function closeModalFn(modalId, formId) { document.getElementById(modalId).style.display = 'none'; document.getElementById(formId).reset(); }
        function postFormAjax(url, formId, onSuccess) {
            var form = document.getElementById(formId);
            var fd = new FormData(form);
            fetch(url, { method: 'POST', body: fd })
            .then(function(r) { return r.json(); })
            .then(function(data) { if (data.success) onSuccess(data); else window.EventHubSwal.error(data.message || 'Error al guardar'); })
            .catch(function() { window.EventHubSwal.error('Error de conexión'); });
        }

        // ===== Client Modal =====
        var clientModal = document.getElementById('clientModal');
        document.getElementById('openClientModal').addEventListener('click', function(e) { e.preventDefault(); openModal('clientModal'); });
        document.getElementById('closeClientModal').addEventListener('click', function() { closeModalFn('clientModal', 'clientForm'); });
        document.getElementById('cancelClientModal').addEventListener('click', function() { closeModalFn('clientModal', 'clientForm'); });
        clientModal.addEventListener('click', function(e) { if (e.target === clientModal) closeModalFn('clientModal', 'clientForm'); });
        document.getElementById('saveClientBtn').addEventListener('click', function() {
            var form = document.getElementById('clientForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }
            postFormAjax('@Url.Action("CreateAjax", "Clientes")', 'clientForm', function(data) {
                var sel = document.getElementById('ClienteId');
                var opt = document.createElement('option');
                opt.value = data.clienteId; opt.text = data.nombre; opt.selected = true;
                sel.add(opt);
                closeModalFn('clientModal', 'clientForm');
            });
        });

        // ===== Venue Modal =====
        var venueModal = document.getElementById('venueModal');
        document.getElementById('openVenueModal').addEventListener('click', function(e) { e.preventDefault(); openModal('venueModal'); });
        document.getElementById('closeVenueModal').addEventListener('click', function() { closeModalFn('venueModal', 'venueForm'); });
        document.getElementById('cancelVenueModal').addEventListener('click', function() { closeModalFn('venueModal', 'venueForm'); });
        venueModal.addEventListener('click', function(e) { if (e.target === venueModal) closeModalFn('venueModal', 'venueForm'); });
        document.getElementById('saveVenueBtn').addEventListener('click', function() {
            var form = document.getElementById('venueForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }
            postFormAjax('@Url.Action("CreateVenueAjax", "Eventos")', 'venueForm', function(data) {
                var sel = document.getElementById('VenueId');
                var opt = document.createElement('option');
                opt.value = data.venueId; opt.text = data.nombre; opt.selected = true;
                sel.add(opt);
                closeModalFn('venueModal', 'venueForm');
            });
        });

        // ===== Tipo Evento Modal =====
        var tipoModal = document.getElementById('tipoEventoModal');
        document.getElementById('openTipoEventoModal').addEventListener('click', function(e) { e.preventDefault(); openModal('tipoEventoModal'); });
        document.getElementById('closeTipoEventoModal').addEventListener('click', function() { closeModalFn('tipoEventoModal', 'tipoEventoForm'); });
        document.getElementById('cancelTipoEventoModal').addEventListener('click', function() { closeModalFn('tipoEventoModal', 'tipoEventoForm'); });
        tipoModal.addEventListener('click', function(e) { if (e.target === tipoModal) closeModalFn('tipoEventoModal', 'tipoEventoForm'); });
        document.getElementById('saveTipoEventoBtn').addEventListener('click', function() {
            var form = document.getElementById('tipoEventoForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }
            postFormAjax('@Url.Action("CreateTipoEventoAjax", "Eventos")', 'tipoEventoForm', function(data) {
                var sel = document.getElementById('TipoEventoId');
                var opt = document.createElement('option');
                opt.value = data.tipoEventoId; opt.text = data.nombre; opt.selected = true;
                sel.add(opt);
                closeModalFn('tipoEventoModal', 'tipoEventoForm');
            });
        });
    </script>
}
