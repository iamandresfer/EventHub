@model EventHub._02.Bussines.DTOs.EventoListDto
@using EventHub._01.Web.Helpers
@{
    ViewBag.Title = Model.Nombre;
    ViewBag.HideSectionHeader = true;
    var crewList = ViewBag.CrewList as List<EventHub._02.Bussines.DTOs.OperadorDto> ?? new List<EventHub._02.Bussines.DTOs.OperadorDto>();
}

<div class="event-dashboard">
    <!-- Event Banner -->
    <div class="event-banner">
        @if (!string.IsNullOrEmpty(Model.CoverPhotoUrl))
        {
            <div class="event-banner__bg" style="background-image: url('@Model.CoverPhotoUrl');"></div>
        }
        else
        {
            <div class="event-banner__bg event-banner__bg--placeholder"></div>
        }
        <div class="event-banner__content">
            <div class="event-banner__info">
                <div class="event-banner__header">
                    <h1>@Model.Nombre</h1>
                    <span class="badge badge-@Model.Estado.ToLower()">@Model.Estado</span>
                </div>
                <div class="event-banner__meta">
                    <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg> @Model.ClienteNombre</span>
                    <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> @Model.VenueNombre</span>
                </div>
                <div class="event-banner__dates">
                    <span>@Model.FechaInicio.ToString("dd/MM/yyyy") – @Model.FechaFin.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
            <div class="event-banner__actions">
                <a href="@Url.Action("Index")" class="btn btn-outline btn-sm" style="border-color:rgba(255,255,255,0.3);color:#fff;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                    Volver
                </a>
                @if (Model.Estado != "Finalizado" && Model.Estado != "Cancelado")
                {
                    <a href="@Url.Action("Tareas", new { id = Model.Id })" class="btn btn-outline btn-sm" style="background:#fff; color:var(--primary); border-color:#fff;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                        Tareas
                    </a>
                    <a href="@Url.Action("Index", "Crew", new { eventoId = Model.Id })" class="btn btn-outline btn-sm" style="background:#fff; color:var(--primary); border-color:#fff;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Crew
                    </a>
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary btn-sm">Editar</a>
                }
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 16px 32px; background: var(--bg-secondary); border-bottom: 1px solid var(--border);">
        <div style="text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: var(--text);">@ViewBag.TareasTotales</div>
            <div style="font-size: 12px; color: var(--text-muted);">Tareas Totales</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #10b981;">@ViewBag.TareasCompletadas</div>
            <div style="font-size: 12px; color: var(--text-muted);">Completadas</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #f59e0b;">@ViewBag.TareasPendientes</div>
            <div style="font-size: 12px; color: var(--text-muted);">Pendientes</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 24px; font-weight: 700; color: #8b5cf6;">@ViewBag.CrewCount</div>
            <div style="font-size: 12px; color: var(--text-muted);">Operadores</div>
        </div>
    </div>

    <!-- Content Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 32px;">
        <!-- Left Column -->
        <div>
            <!-- Budget Card -->
            <div class="card" style="margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 14px; font-weight: 600;">Presupuesto</h3>
                    <a href="@Url.Action("Index", "Presupuesto", new { eventoId = Model.Id })" style="background: none; border: 1px solid var(--border); padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer; color: var(--text-muted); text-decoration: none;">Ver detalle</a>
                </div>
                @{
                    var presupuesto = Model.PresupuestoEstimado;
                    var totalIngresos = Model.TotalIngresos ?? 0;
                    var gastoReal = Model.GastoReal ?? 0;
                    var balance = totalIngresos - gastoReal;
                    var tienePresupuesto = presupuesto.HasValue && presupuesto.Value > 0;
                    var porcentaje = tienePresupuesto ? (int)(gastoReal / presupuesto.Value * 100) : 0;
                }
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span style="font-size: 13px; color: var(--text-muted);">Estimado</span>
                    <span style="font-size: 13px; font-weight: 600; @(tienePresupuesto ? "" : "color: var(--text-muted);")">@(tienePresupuesto ? presupuesto.Value.FormatCurrency() : "Sin definir")</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span style="font-size: 13px; color: var(--text-muted);">Recaudado</span>
                    <span style="font-size: 13px; font-weight: 600; color: #10b981;">@totalIngresos.FormatCurrency()</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span style="font-size: 13px; color: var(--text-muted);">Gastado</span>
                    <span style="font-size: 13px; font-weight: 600; color: #f59e0b;">@gastoReal.FormatCurrency()</span>
                </div>
                @if (tienePresupuesto)
                {
                    <div style="height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; margin-bottom: 4px;">
                        <div style="width: @Math.Min(porcentaje, 100)%; height: 100%; background: linear-gradient(90deg, #10b981, #3b82f6); border-radius: 3px;"></div>
                    </div>
                }
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);">
                    <span>@(tienePresupuesto ? porcentaje + "% ejecutado" : "Sin presupuesto definido")</span>
                    <span style="color: @(balance >= 0 ? "var(--text-muted)" : "#ef4444"); font-weight:600;">Balance: @balance.FormatCurrency()</span>
                </div>
                <div id="eventBudgetDonut" style="height:130px; margin-top:8px;"></div>
            </div>

            <!-- Client Card -->
            <div class="card">
                <h3 style="margin: 0 0 12px 0; font-size: 14px; font-weight: 600;">Cliente</h3>
                <div style="font-size: 15px; font-weight: 600; margin-bottom: 4px;">@Model.ClienteNombre</div>
                <div style="font-size: 12px; color: var(--text-muted);">@Model.TipoEvento</div>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <!-- Recent Tasks -->
            <div class="card" style="margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 14px; font-weight: 600;">Tareas</h3>
                    <a href="@Url.Action("Tareas", new { id = Model.Id })" style="background: none; border: 1px solid var(--border); padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer; color: var(--text-muted); text-decoration: none;">Ver tablero</a>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    @if (ViewBag.TareasTotales > 0)
                    {
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px; background: var(--bg-secondary); border-radius: 6px;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></div>
                            <span style="font-size: 13px; flex: 1;">@ViewBag.TareasCompletadas tareas completadas</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 8px; background: var(--bg-secondary); border-radius: 6px;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></div>
                            <span style="font-size: 13px; flex: 1;">@ViewBag.TareasPendientes tareas pendientes</span>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 16px; color: var(--text-muted); font-size: 13px;">Sin tareas registradas</div>
                    }
                </div>
            </div>

            <!-- Crew Preview -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h3 style="margin: 0; font-size: 14px; font-weight: 600;">Crew Asignado</h3>
                    <a href="@Url.Action("Index", "Crew", new { eventoId = Model.Id })" style="background: none; border: 1px solid var(--border); padding: 4px 8px; border-radius: 4px; font-size: 11px; cursor: pointer; color: var(--text-muted); text-decoration: none;">Ver todo</a>
                </div>
                @if (crewList.Any())
                {
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var c in crewList)
                        {
                            <div style="display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: var(--bg-secondary); border-radius: 6px;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 600;">@(c.Nombre.Length > 0 ? c.Nombre.Substring(0, 1).ToUpper() : "?")</div>
                                <span style="font-size: 12px;">@c.Nombre</span>
                                @if (!string.IsNullOrEmpty(c.Rol))
                                {
                                    <span style="font-size: 10px; color: var(--primary);">(@c.Rol)</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 16px; color: var(--text-muted); font-size: 13px;">Sin operadores asignados</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .event-dashboard {
        margin: 24px -32px -24px;
    }
    .event-banner {
        position: relative;
        width: 100%;
        height: 320px;
        min-height: 240px;
        overflow: hidden;
        background: var(--sidebar-bg);
    }
    .event-banner__bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
    }
    .event-banner__bg--placeholder {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    .event-banner__content {
        position: relative;
        z-index: 1;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        padding: 32px;
        background: linear-gradient(to top, rgba(15,23,42,0.9) 0%, transparent 100%);
        color: white;
    }
    .event-banner__header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }
    .event-banner__header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #fff;
    }
    .event-banner__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 8px;
        font-size: 14px;
        color: rgba(255,255,255,0.85);
    }
    .event-banner__meta span {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .event-banner__dates {
        font-size: 14px;
        color: rgba(255,255,255,0.7);
    }
    .event-banner__actions {
        display: flex;
        gap: 8px;
    }
    @@media (max-width: 768px) {
        .event-banner { height: 280px; }
        .event-banner__content { flex-direction: column; align-items: flex-start; gap: 16px; padding: 24px; }
        .event-banner__header h1 { font-size: 22px; }
    }
</style>

@section scripts {
<script>
    (function () {
        var el = document.getElementById('eventBudgetDonut');
        if (!el) return;
        var recaudado = @(Model.TotalIngresos ?? 0);
        var gastado = @(Model.GastoReal ?? 0);
        var balance = recaudado - gastado;
        if (recaudado <= 0 && gastado <= 0) {
            el.innerHTML = '<div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:13px;">Sin movimientos</div>';
            return;
        }
        function money(n) {
            return '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        var chart = echarts.init(el);
        chart.setOption({
            tooltip: {
                trigger: 'item',
                formatter: function (p) { return p.name + ': ' + money(p.value); }
            },
            title: {
                text: money(balance),
                subtext: 'Balance',
                left: 'center',
                top: '32%',
                textStyle: { fontSize: 16, fontWeight: 700, color: balance >= 0 ? '#10b981' : '#ef4444', fontFamily: "'Plus Jakarta Sans', sans-serif" },
                subtextStyle: { fontSize: 11, color: '#64748b', fontFamily: "'Plus Jakarta Sans', sans-serif" }
            },
            series: [{
                type: 'pie',
                radius: ['55%', '78%'],
                center: ['50%', '50%'],
                avoidLabelOverlap: false,
                itemStyle: { borderRadius: 6, borderColor: '#fff', borderWidth: 2 },
                label: { show: false },
                emphasis: { label: { show: false } },
                data: [
                    { value: recaudado, name: 'Recaudado', itemStyle: { color: '#10b981' } },
                    { value: gastado, name: 'Gastado', itemStyle: { color: '#f59e0b' } }
                ]
            }]
        });
        window.addEventListener('resize', function () { chart.resize(); });
    })();
</script>
}
